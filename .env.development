# Local development overrides. Loaded by `next dev` before `.env`,
# so these values win during development only.
#
# Points the app at the Docker-based Redis from `docker-compose.yml`.
# The URL and token must match `SRH_TOKEN` in that file.
# Production and `next build` continue to use the Upstash credentials
# from `.env`.
#
# This file is tracked on purpose, it holds no secrets.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token
