# AniCards example env file. Copy to `.env.local` and fill in production values.

# AniList GraphQL token (server):
ANILIST_TOKEN=

# Upstash Redis connection (server):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (server): token used to apply schedules and publish refresh messages.
# Not needed for the app to serve requests, only for the cron fan-out.
QSTASH_TOKEN=
# Optional: override the QStash API base URL (defaults to the hosted service).
QSTASH_URL=
# Optional: run the local QStash dev server. In memory only, so schedules and
# messages disappear on restart. QSTASH_TOKEN is still required.
# QSTASH_DEV=
# QSTASH_DEV_PORT=

# Analytics & Site configuration
# Public site origin. Also used as the production fallback for the JSON API CORS origin.
NEXT_PUBLIC_SITE_URL=https://anicards.alpha49.com
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Canonical app origin; takes precedence for the JSON API CORS origin when set.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Card SVG CORS origin (restrict in production)
NEXT_PUBLIC_CARD_SVG_ALLOWED_ORIGIN=

# Cron secret used to authenticate background cron endpoints.
CRON_SECRET=
# Local development only. Set to "true" to accept unauthenticated cron calls
# when CRON_SECRET is unset and NODE_ENV is development.
# CRON_SECRET_DEV_BYPASS=

# Optional API secret for internal APIs
API_SECRET_TOKEN=changeme

# Vercel (set in production hosting) - don't use in local .env; the value gets set by the platform
VERCEL=

# Use `VERCEL=1` in production if needed; keep empty in local dev
