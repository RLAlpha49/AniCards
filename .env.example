# AniCards example env file. Copy to `.env.local` for local dev, or update with production values when deploying.

# AniList GraphQL token (server):
ANILIST_TOKEN=

# Upstash Redis connection (server):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics & Site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Card SVG CORS origin (restrict in production)
NEXT_PUBLIC_CARD_SVG_ALLOWED_ORIGIN=

# Cron secret used to authenticate background cron endpoints (required outside local dev)
CRON_SECRET=changeme

# Root server-side signing secret. AniCards derives separate request-proof and
# protected-write subkeys from this value.
# Required in production for /api/anilist, /api/store-users, /api/store-cards, and /api/convert.
API_SECRET_TOKEN=changeme

# Optional localhost-only development escape hatch for request-proof and
# protected-write signing when you intentionally do not want to set a real
# API_SECRET_TOKEN. Ignored outside explicit localhost development.
ALLOW_INSECURE_LOCALHOST_SECRETS=

# Optional comma-separated trusted client IP headers for non-default proxy/CDN deployments.
# Built-in Vercel/Cloudflare defaults stay enabled even when you add custom headers.
TRUSTED_CLIENT_IP_HEADERS=

# Required when TRUSTED_CLIENT_IP_HEADERS adds custom headers. Format:
# header=provenance-header|alternate-provenance-header,other-header=proxy-proof-header
TRUSTED_CLIENT_IP_HEADER_PROVENANCE=

# Boolean env toggles use literal true/false values. Leave blank to keep the default behavior.

# Set to true only for local development if you intentionally want unsecured cron access.
ALLOW_UNSECURED_CRON_IN_DEV=

# Set to true to force AniList upstream callers into degraded mode when the upstream is unhealthy.
ANILIST_UPSTREAM_DEGRADED_MODE=

# Set to true only when you explicitly want Upstash Redis latency logs during local diagnostics.
UPSTASH_REDIS_LATENCY_LOGGING=

# Vercel (set in production hosting) - don't use in local .env; the value gets set by the platform
VERCEL=

# Use `VERCEL=1` in production if needed; keep empty in local dev
